generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DEPARTMENT_HEAD
  LECTURER
  MODERATOR
}

enum PaperStatus {
  DRAFT
  UNDER_MODERATION
  REVISION_REQUIRED
  FINALIZED
}

model User {
  id                   String   @id @default(cuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  email                String   @unique
  name                 String
  password             String
  role                 UserRole
  contact              String?
  department           String?
  facultyBoardApproved Boolean  @default(true)

  // relations
  firstExaminerSubjects Subject[] @relation("FirstExaminerSubjects")
  lecturedSubjects      Subject[] @relation("LecturerSubjects")
  moderatedSubjects     Subject[] @relation("ModeratorSubjects")

  papers  Paper[]
  reports ModerationReport[]
}

model Subject {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  code            String   @unique
  name            String
  academicYear    String
  semester        Int
  department      String?

  firstExaminerId String?
  firstExaminer   User?    @relation("FirstExaminerSubjects", fields: [firstExaminerId], references: [id])

  lecturerId      String?
  lecturer        User?    @relation("LecturerSubjects", fields: [lecturerId], references: [id])

  lecturerIds     Json?

  moderatorId     String?
  moderator       User?    @relation("ModeratorSubjects", fields: [moderatorId], references: [id])

  papers          Paper[]
}

model Paper {
  id                        String      @id @default(cuid())
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  subjectId                 String
  subject                   Subject     @relation(fields: [subjectId], references: [id])

  lecturerId                String
  lecturer                  User        @relation(fields: [lecturerId], references: [id])

  academicYear              String
  semester                  Int

  status                    PaperStatus @default(DRAFT)

  paperUrl                  String?
  paperWordUrl              String?
  markingSchemeUrl          String?
  markingSchemeWordUrl      String?

  draftPaperUrl             String?
  draftPaperWordUrl         String?
  draftMarkingSchemeUrl     String?
  draftMarkingSchemeWordUrl String?

  filePassword              String?
  sentToHod                 Boolean     @default(false)
  sentToHodAt               DateTime?

  moderationReport          ModerationReport?
}

model ModerationReport {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  paperId               String   @unique
  paper                 Paper    @relation(fields: [paperId], references: [id])

  moderatorId           String
  moderator             User     @relation(fields: [moderatorId], references: [id])

  remarks               Json
  additionalComments    String?
  followUpActions       Json?
  moderatorSignatureUrl String?
  lecturerSignatureUrl  String?
  reportPdfUrl          String?
  reportWordUrl         String?
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
